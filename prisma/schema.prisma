generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model UserSettings {
  userId   String @id
  currency String
}

model Category {
  createdAt DateTime @default(now())
  name      String
  userId    String
  icon      String
  type      String @default("ORDER") // Default type is "ORDER", but it can be "RETURN" as well

  @@unique([name, userId, type])
}

model Strain {
  id        String   @id @default(uuid())
  name      String
  type      String   // e.g., Indica, Sativa, Hybrid
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  products  Product[]

  @@unique([name, type])
}

model Grower {
  id        String   @id @default(uuid())
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  products  Product[]
}

model Transaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updateAt  DateTime @default(now())

  amount      Float
  description String
  date        DateTime
  userId      String
  type        String   @default("ORDER") // Default type is "ORDER", but it can be "RETURN" as well

  category     String
  categoryIcon String
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
}

model Product {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updateAt  DateTime @default(now())

  amount      Float
  description Float?
  date        DateTime
  userId      String
  type        String   @default("IMPORT") // Default type is "IMPORT", but it can be "RETURN" as well

  category     String
  categoryIcon String
  strainId     String?
  strain       Strain?  @relation(fields: [strainId], references: [id])
  growerId     String?
  grower       Grower?  @relation(fields: [growerId], references: [id])
  transactions Transaction[]
}

model MonthHistory {
  userId  String
  day     Int
  month   Int
  year    Int
  order   Float
  returns Float

  @@id([userId, day, month, year])
}

model YearHistory {
  userId  String
  month   Int
  year    Int
  order   Float
  returns Float

  @@id([month, year, userId])
}