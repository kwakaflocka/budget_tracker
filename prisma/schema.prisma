// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model UserSettings {
  userId   String @id
  Unit     String @default("USD")
  currency String @default("USD")
}

model Strain {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  name      String
  userId    String
  icon      String
  type      String    @default("income")
  products  Product[] @relation("StrainToProduct")

  @@unique([name, userId, type])
}

model Category {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String
  userId    String
  icon      String
  type      String   @default("income")

  @@unique([name, userId, type])
}

model Grower {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  name      String
  userId    String
  icon      String
  type      String    @default("income")
  products  Product[] @relation("GrowerToProduct")

  @@unique([name, userId, type])
}

model Transaction {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  amount       Float
  description  String
  date         DateTime
  userId       String
  type         String   @default("income")
  strain       String
  strainIcon   String
  category     String
  categoryIcon String
  grower       String
  growerIcon   String
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
}

model Product {
  id           String        @id @default(uuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())
  name         String        @unique
  strainId     String?
  strain       Strain?       @relation("StrainToProduct", fields: [strainId], references: [id])
  growerId     String?
  grower       Grower?       @relation("GrowerToProduct", fields: [growerId], references: [id])
  transactions Transaction[]
}

model MonthHistory {
  userId  String
  day     Int
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([day, month, year, userId])
}

model YearHistory {
  userId  String
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([month, year, userId])
}
